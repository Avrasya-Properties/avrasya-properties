# ==============================================================================
# Avrasya Properties - Environment Variables Template
# ==============================================================================
# IMPORTANT: Placeholders ONLY. Do NOT commit production secrets to Git.

# --- Supabase Public Client (Browser-Safe) ---
VITE_SUPABASE_URL=https://<your-project-id>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-publishable-key>

# --- Supabase Server-Side Admin / Edge Function Keys (RESTRICTED - SERVER ONLY) ---
# NEVER expose the service role key to VITE_* variables or browser bundles.
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-secret-key>
SUPABASE_PROJECT_ID=<your-project-id>

# --- Initial Administrator Bootstrap (Run once during setup) ---
INITIAL_ADMIN_EMAIL=admin@avrasyaproperties.com
INITIAL_ADMIN_PASSWORD=<change-me-to-a-secure-temporary-password>
INITIAL_ADMIN_NAME="System Administrator"

# --- External Sync & Integration APIs (Server-Side Only) ---
# Google Cloud Service Account credentials for live Google Drive polling
# Format: JSON string or path to service_account.json
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=1IXZqHmdZ8mU_klyEu8vC-80sqjpqBZz_

# Frankfurter / Central Bank exchange rate service URL
EXCHANGE_RATE_API_URL=https://api.frankfurter.app/latest?from=USD&to=TRY,EUR,GBP
