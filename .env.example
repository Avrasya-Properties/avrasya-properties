# ==============================================================================
# Avrasya Properties - Environment Variables Template
# ==============================================================================
# IMPORTANT: Placeholders ONLY. Do NOT commit production secrets to Git.

# --- Supabase Public Client (Browser-Safe) ---
VITE_SUPABASE_URL=https://ufcpvjhzitmxgitoaolx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_ENABLE_ADMIN_DEMO=false
# An isolated demo requires BOTH this flag and --mode demo. Normal builds always use Supabase.
# VITE_ENABLE_ADMIN_DEMO=true bun run dev --mode demo

# --- Supabase Server-Side Admin / Edge Function Keys (RESTRICTED - SERVER ONLY) ---
# NEVER expose the service role key to VITE_* variables or browser bundles.
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-secret-key>
SUPABASE_PROJECT_ID=<your-project-id>

# The administrator already exists in Supabase Auth. Do not re-bootstrap or embed passwords.

# --- External Sync & Integration APIs (Server-Side Only) ---
# Google Cloud Service Account credentials for live Google Drive polling
# Format: JSON string or path to service_account.json
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=1IXZqHmdZ8mU_klyEu8vC-80sqjpqBZz_

# Frankfurter / Central Bank exchange rate service URL
EXCHANGE_RATE_API_URL=https://api.frankfurter.app/latest?from=USD&to=TRY,EUR,GBP
# Never put a service-role key or database password in a VITE variable.


# --- Edge function secrets (Supabase dashboard -> Edge Functions -> Secrets; NEVER VITE_* variables) ---
# Exact website origins, comma separated, e.g. https://avrasyaproperties.com,https://www.avrasyaproperties.com
# Required by submit-enquiry (it returns 503 without it). When set it also restricts admin-access and staff-accounts to these origins.
WEBSITE_ALLOWED_ORIGINS=
# Only needed if the project publishable key is rotated or you use a staging project (submit-enquiry compares the apikey header).
WEBSITE_PUBLISHABLE_KEY=
# Do NOT set until a Turnstile widget is added to the enquiry form; with it set the endpoint rejects every submission.
TURNSTILE_SECRET_KEY=
# Only for bootstrapping a brand new project; the live administrator already exists.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- Admin security mail (Supabase Edge secrets; NEVER VITE_* variables) ---
RESEND_API_KEY=
ADMIN_MAIL_FROM=
ADMIN_SITE_URL=
# ADMIN_SITE_URL must be the exact published HTTPS website URL.
# Recovery/alerts for admin@avrasyaproperties.com go to info.avrasyaproperties@gmail.com.
